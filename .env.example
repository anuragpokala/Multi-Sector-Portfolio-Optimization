# API Keys for Sentiment-Based Portfolio Optimization
# Copy this file to .env and replace with your actual API keys

# Polygon.io API Key
# Get free tier at: https://polygon.io/
# Free tier: 5 requests/minute (sufficient for 8 stocks)
POLYGON_API_KEY=your_polygon_api_key_here

# Finnhub API Key  
# Get free tier at: https://finnhub.io/
# Free tier: 60 requests/minute
FINNHUB_API_KEY=your_finnhub_api_key_here

# Hugging Face Token (OPTIONAL)
# Only needed if you want to use private/gated models
# FinBERT (ProsusAI/finbert) is public and doesn't require authentication
# Get token at: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here
